# 全仓库共享的默认配置（唯一配置源）。
# 所有前后端配置统一在此维护。apps/web/.env、apps/api/.env 仅在需要按应用覆盖时使用。
# 加载顺序（后者覆盖前者，进程环境变量始终最高优先级）：
#   1. 根目录 .env
#   2. apps/web/.env 或 apps/api/.env
#   3. 根目录 .env.local
#   4. apps/web/.env.local 或 apps/api/.env.local

[web]
# 前端部署子路径。留空表示从域名根路径（/）提供页面。
# 示例：myapp 或 /myapp -> https://example.com/myapp/
VITE_BASE_PATH=

# 前端请求 API 的 origin。业务代码里的接口路径已经包含 /api。
# 本地开发默认指向 MVP 前端 dev server，让浏览器请求 http://localhost:3005/api/...；
# 再由 Vite proxy 转发到真实后端，避免浏览器直接跨端口调用后端产生 CORS。
# 注意：此变量只用于业务 axios，不用于 AI101 ticket 换 token（换票走 Vite 专用 proxy）。
# 生产部署如果前后端同域，可以改为空；如果前后端分域，改成真实 API origin。
VITE_API_BASE_URL=http://localhost:3005

# MVP 侧信任的 AI101 父窗口 origin 列表（逗号分隔），只填写 AI101 主平台页面 origin。
# 这不是 AI101 平台的 MVP URL 白名单；
# MVP URL 请在 Agent 工具配置页填写。
VITE_AI101_PARENT_ORIGINS=https://www.zcat.cn,https://www.kjxhai.cn,https://t.aix101.com
VITE_AI101_CLIENT_NAME=mvp-template

# 顶层直访登录开关（非 iframe 内打开 MVP 时使用）。
# 开启后：无 token/ticket 时会跳转登录页；回跳带 ticket 时自动换 token。
# 未配置时：本地开发默认关闭，生产环境默认开启。
# 本地联调直访登录和首页「登录」按钮时设为 true。
VITE_AI101_DIRECT_AUTH=true

# AI101 统一登录入口 origin，只配置平台 origin，不配置具体登录路由。
# auth-bridge 会固定拼接平台登录中转路由 /sso-login，并附带 from=当前页地址。
VITE_AI101_LOGIN_ORIGIN=https://www.zcat.cn

# AI101 平台 API origin，前端会在构建时静态注入，顶层直访回跳后用于 ticket 换 token。
# 本地开发时 Vite proxy 也复用该值转发 /api/public/user/account/login_auto。
VITE_AI101_API_BASE_URL=https://api.zcat.cn

# 回跳 URL 上携带一次性凭证的参数名，默认 ticket。
VITE_AI101_TICKET_PARAM=ticket

[api]
SERVER_ADDR=:8088
WEB_STATIC_DIR=

# Go 托管前端静态资源时，需与 VITE_BASE_PATH 保持一致。
WEB_BASE_PATH=

[database]
DB_DRIVER=postgres
DB_DSN=postgres://user:pass@127.0.0.1:5432/mvp_template?sslmode=disable
DB_AUTO_MIGRATE=false

[sample]
SAMPLE_TABLE_NAME=sample_items

[web.weekly-plan]
# true（默认）：周计划与 LLM 走后端 API；false：Phase A 本地模式（localStorage + 浏览器直连 DeepSeek）
# false：周计划/教案走纯前端平台智能体（推荐本地）；true 时保存等走 Go BFF
VITE_USE_BACKEND_API=false

# Phase A 本地模式专用（VITE_USE_BACKEND_API=false 时）
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-chat

# 默认知识库（对应 https://www.zcat.cn/teach/knowledge/detail/10298）
VITE_DEFAULT_KNOWLEDGE_ID=10298
# 教案分类（课程资源库）
VITE_DEFAULT_KNOWLEDGE_CATEGORY_ID=20806
VITE_DEFAULT_KNOWLEDGE_CATEGORY_KEY=custom_1784259353619
# 周计划分类（周计划管理 / 可选上传）
# https://www.zcat.cn/teach/knowledge/detail/10298?category_id=20807&category_key=custom_1784275664825
VITE_WEEKLY_PLAN_KNOWLEDGE_CATEGORY_ID=20807
VITE_WEEKLY_PLAN_KNOWLEDGE_CATEGORY_KEY=custom_1784275664825
# 教师成果库分类（成果库「平台 · 教师成果库」）
# https://www.zcat.cn/teach/knowledge/detail/10298?category_id=20895&category_key=custom_1785116184487
VITE_ARCHIVE_KNOWLEDGE_CATEGORY_ID=20895
VITE_ARCHIVE_KNOWLEDGE_CATEGORY_KEY=custom_1785116184487

# 平台知识库 API（纯前端直连；本地由 Vite 把 /api/knowledge 代理到此地址）
VITE_PLATFORM_API_BASE_URL=https://api.zcat.cn
VITE_PLATFORM_REFERER=https://www.zcat.cn

# 教案生成使用的平台智能体 ID（teach/agent/config/{id}）
VITE_TEACHING_AGENT_ID=14317
# 周计划生成使用的平台智能体 ID（https://www.zcat.cn/teach/agent/config/14332）
VITE_WEEKLY_PLAN_AGENT_ID=14332
# 教师画像智能体 ID（请在平台创建后填写；不要挂载整库自动检索，由前端注入手机号文件夹摘要）
# 教师画像智能体 https://www.zcat.cn/teach/agent/config/14372
VITE_PROFILE_AGENT_ID=14372

[api.platform]
PLATFORM_API_BASE_URL=https://api.zcat.cn
PLATFORM_REFERER=https://www.zcat.cn
PLATFORM_MVP=mvp-template
KNOWLEDGE_LIST_PATH=/api/knowledge/document/list
KNOWLEDGE_DETAIL_PATH=/api/knowledge/document/detail
KNOWLEDGE_UPLOAD_PATH=/api/knowledge/document/text
DEFAULT_KNOWLEDGE_ID=10298

[database.local]
# 本地快速启动可改用 SQLite（无需 Postgres）：
# DB_DRIVER=sqlite
# DB_DSN=./data/mvp.db
# DB_AUTO_MIGRATE=true

[api.llm]
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

[api.weekly-plan]
WEEKLY_PLAN_TABLE_NAME=weekly_plans

[dev]
# Vite 开发服务器 /api 代理目标（vite.config.ts）。
LOCAL_API_BASE_URL=http://127.0.0.1:8088
