# 全仓库共享的默认配置（唯一配置源）。
# 所有前后端配置统一在此维护。apps/web/.env、apps/api/.env 仅在需要按应用覆盖时使用。
# 加载顺序（后者覆盖前者，进程环境变量始终最高优先级）：
#   1. 根目录 .env
#   2. apps/web/.env 或 apps/api/.env
#   3. 根目录 .env.local
#   4. apps/web/.env.local 或 apps/api/.env.local

[web]
# 前端部署子路径。留空表示从域名根路径（/）提供页面。
# 示例：myapp 或 /myapp -> https://example.com/myapp/
VITE_BASE_PATH=

# 前端请求 API 的 origin。业务代码里的接口路径已经包含 /api。
# 本地开发默认指向 MVP 前端 dev server，让浏览器请求 http://localhost:3005/api/...；
# 再由 Vite proxy 转发到真实后端，避免浏览器直接跨端口调用后端产生 CORS。
# 注意：此变量只用于业务 axios，不用于 AI101 ticket 换 token（换票走 Vite 专用 proxy）。
# 生产部署如果前后端同域，可以改为空；如果前后端分域，改成真实 API origin。
VITE_API_BASE_URL=http://localhost:3005

# MVP 侧信任的 AI101 父窗口 origin 列表（逗号分隔），只填写 AI101 主平台页面 origin。
# 这不是 AI101 平台的 MVP URL 白名单；
# MVP URL 请在 Agent 工具配置页填写。
VITE_AI101_PARENT_ORIGINS=https://www.zcat.cn,https://www.kjxhai.cn,https://t.aix101.com
VITE_AI101_CLIENT_NAME=mvp-template

# 顶层直访登录开关（非 iframe 内打开 MVP 时使用）。
# 开启后：无 token/ticket 时会跳转登录页；回跳带 ticket 时自动换 token。
# 未配置时：本地开发默认关闭，生产环境默认开启。
# 本地联调直访登录和首页「登录」按钮时设为 true。
VITE_AI101_DIRECT_AUTH=

# AI101 统一登录入口 origin，只配置平台 origin，不配置具体登录路由。
# auth-bridge 会固定拼接平台登录中转路由 /sso-login，并附带 from=当前页地址。
VITE_AI101_LOGIN_ORIGIN=https://www.zcat.cn

# AI101 平台 API origin，前端会在构建时静态注入，顶层直访回跳后用于 ticket 换 token。
# 本地开发时 Vite proxy 也复用该值转发 /api/public/user/account/login_auto。
VITE_AI101_API_BASE_URL=https://api.zcat.cn

# 回跳 URL 上携带一次性凭证的参数名，默认 ticket。
VITE_AI101_TICKET_PARAM=ticket

[api]
SERVER_ADDR=:8088
WEB_STATIC_DIR=

# Go 托管前端静态资源时，需与 VITE_BASE_PATH 保持一致。
WEB_BASE_PATH=

[database]
DB_DRIVER=postgres
DB_DSN=postgres://user:pass@127.0.0.1:5432/mvp_template?sslmode=disable
DB_AUTO_MIGRATE=false

[sample]
SAMPLE_TABLE_NAME=sample_items

[dev]
# Vite 开发服务器 /api 代理目标（vite.config.ts）。
LOCAL_API_BASE_URL=http://127.0.0.1:8088
