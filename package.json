{
  "name": "mvp-template-root",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "install:web": "pnpm install",
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:backend": "cd apps/api && go run ./cmd/server",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter ./apps/web build",
    "build:backend": "cd apps/api && go build ./...",
    "test:backend": "cd apps/api && go test ./...",
    "lint": "pnpm --filter ./apps/web lint",
    "preview": "pnpm --filter ./apps/web preview",
    "ci": "./scripts/ci.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  }
}
